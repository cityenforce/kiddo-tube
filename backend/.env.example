# KidsStream Backend Environment Configuration Template
# ========================================================

# Server Port
PORT=4000
BACKEND_PORT=4000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Database Configuration
# Local WiredTiger MongoDB instance or MongoDB Atlas URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=kidsstream

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Resend Email Service Configuration (for Password Reset OTP)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=KiddoTube <onboarding@resend.dev>
