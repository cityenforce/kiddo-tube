# KidsStream React Native App — Environment Configuration
# Copy this file to `.env` and fill in actual values.

# ─── API URLs ────────────────────────────────────────
# Development (Android emulator: 10.0.2.2 maps to host machine)
API_BASE_URL_ANDROID_DEV=http://10.0.2.2:4000/
# Development (iOS simulator uses localhost directly)
API_BASE_URL_IOS_DEV=http://127.0.0.1:4000/
# Production (cloud backend)
API_BASE_URL_PRODUCTION=https://ais-dev-jikcox2ra6y7i7pgcwl5hu-593908721251.asia-southeast1.run.app/

# ─── Notes ───────────────────────────────────────────
# These URLs are also hard-coded in src/app/config/env.ts as fallbacks.
# The env.ts file is the single source of truth for base URLs in dev/prod.
#
# For physical device testing, set API_BASE_URL_ANDROID_DEV to your
# computer's LAN IP (e.g. http://192.168.1.10:4000/).